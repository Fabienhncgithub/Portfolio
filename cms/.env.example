# Runtime
HOST=127.0.0.1
PORT=1337
NODE_ENV=development

# Public production URL of the CMS: https://cms.fabienhance.com
PUBLIC_URL=

# Comma-separated browser origins allowed to call Strapi.
# Production: https://www.fabienhance.com,https://fabienhance.com
CORS_ORIGINS=http://localhost:3000

# Required secrets. Generate independent, cryptographically random values.
# APP_KEYS must contain at least two comma-separated keys.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# SQLite is intended for local development only.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production database. Prefer DATABASE_URL with PostgreSQL and TLS enabled.
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SCHEMA=public
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000
