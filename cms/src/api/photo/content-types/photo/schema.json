{
  "kind": "collectionType",
  "collectionName": "photos",
  "info": {
    "singularName": "photo",
    "pluralName": "photos",
    "displayName": "Photo",
    "description": "Créer une entrée Photo par image, puis la publier pour l’afficher sur le portfolio"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "location": {
      "type": "string"
    },
    "year": {
      "type": "integer",
      "min": 1900,
      "max": 2100
    },
    "category": {
      "type": "enumeration",
      "enum": ["Landscape", "City", "Travel", "Details"],
      "default": "Details"
    },
    "camera": {
      "type": "string"
    },
    "film": {
      "type": "string"
    }
  }
}
