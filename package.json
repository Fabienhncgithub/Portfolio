{
  "name": "fabien-hance-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.9.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "cms:dev": "pnpm --dir cms develop",
    "cms:build": "pnpm --dir cms build",
    "cms:typecheck": "pnpm --dir cms exec tsc --noEmit",
    "build": "node scripts/build-next.mjs",
    "build:hosting": "node scripts/build-hosting.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm cms:typecheck",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.2",
    "sass": "^1.102.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.114.0"
  }
}
