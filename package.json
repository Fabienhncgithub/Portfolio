{
  "name": "fabien-hance-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.9.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "cms:dev": "pnpm --dir cms develop",
    "cms:build": "pnpm --dir cms build",
    "cms:typecheck": "pnpm --dir cms exec tsc --noEmit",
    "build": "node scripts/build-next.mjs",
    "build:hosting": "node scripts/build-hosting.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm cms:typecheck",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "sass": "^1.104.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  }
}
