# Server-only URL used by Next.js to query Strapi.
# Production: https://cms.fabienhance.com
STRAPI_URL=http://localhost:1337
# Public media origin compiled into the Next.js image allowlist.
# Useful when content is fetched only after the container starts.
STRAPI_MEDIA_URL=
# Optional private server-to-server URL, useful in Docker.
STRAPI_INTERNAL_URL=
# Required when Strapi is configured. Use a read-only token limited to Photo.
STRAPI_API_TOKEN=
# Shared secret (at least 32 random characters) sent by the Strapi webhook.
STRAPI_WEBHOOK_SECRET=
# Fail instead of showing local fallback content when Strapi is unavailable.
CMS_REQUIRED=false
# Public canonical URL used for SEO metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://www.fabienhance.com
# Google Analytics 4 web stream measurement ID (format: G-XXXXXXXXXX).
# The Google script loads only after explicit visitor consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
