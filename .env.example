# Server-only URL used by Next.js to query Strapi.
STRAPI_URL=http://localhost:1337
# Optional for private API permissions. Never expose this token publicly.
STRAPI_API_TOKEN=
# Shared secret sent by the Strapi webhook in the x-revalidate-secret header.
STRAPI_WEBHOOK_SECRET=
# Public canonical URL used for SEO metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://fabienhance.com
# Google Analytics 4 measurement ID. Leave empty until consent handling is enabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
